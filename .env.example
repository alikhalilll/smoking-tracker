# Supabase configuration. Copy this file to .env.local and fill in the values.
# When unset, the app runs in local-only mode (localStorage), no auth UI.
# The publishable key is public by design — Row Level Security on the
# Supabase tables is what protects user data.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Older projects exported the same value as VITE_SUPABASE_ANON_KEY — that
# name still works as a fallback if you have it configured already.
